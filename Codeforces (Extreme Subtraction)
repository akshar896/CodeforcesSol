    while(t--){
        int n;
        cin>>n;
        vector<ll>a(n);
        f(i,n)cin>>a[i];
        vector<int>diff;
        f(i,n){
            if(i==0){
                diff.push_back(a[i]);
            }
            else{
                diff.push_back(a[i]-a[i-1]);
            }
        }
        diff.push_back(-a[n-1]);
        debug(diff)
        for(int i=1;i<n;i++){
            if(diff[i]<0){
                diff[0]+=diff[i];
                diff[i]=0;
            }
        }
        debug(diff)
        if(diff[0]<0){
            cout<<"NO"<<endl;
            continue;
        }
        for(int i=0;i<n;i++){
            diff[n]+=diff[i];
        }
        if(diff[n]>0){
            cout<<"NO"<<endl;
            continue;
        }
        cout<<"YES"<<endl;
    }
